---
interface Props {
  name:
    | 'arrow'
    | 'diagonal'
    | 'scissors'
    | 'chat'
    | 'pin'
    | 'clock'
    | 'close'
    | 'plus';
  class?: string;
}
const { name, class: className } = Astro.props;
const paths = {
  arrow: 'M4 12h16m-6-6 6 6-6 6',
  diagonal: 'M5 19 19 5M5 5h14v14',
  scissors:
    'm8 8 11 11M8 16 19 5M9 12l-2-2m0 4 2-2M4.5 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm0 11a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  chat: 'M21 11.5a9 9 0 0 1-13.3 7.9L3 21l1.6-4.7A9 9 0 1 1 21 11.5ZM8 8c0 4 2 6 6 7l2-2-3-1-1 1-2-2 1-1-1-3-2 1Z',
  pin: 'M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 0 1 16 0ZM15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  clock: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  close: 'm6 6 12 12M6 18 18 6',
  plus: 'M12 4v16M4 12h16',
};
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
